# Variables de Entorno (Opcional)
# Copia este archivo como .env para desarrollo local si deseas utilizar tu Token anónimo de FormSubmit:
# VITE_FORMSUBMIT_TOKEN=tu_token_aqui
#
# Al usar el token anónimo de FormSubmit, tu dirección de correo electrónico real
# no aparecerá en el código ni en las peticiones del navegador, protegiéndote de bots y scrapers.
VITE_FORMSUBMIT_TOKEN=

